# Campus Customs — environment
#
# Copy this file to `.env` in this folder and fill in your own key:
#     cp .env.example .env
#
# `.env` is listed in .gitignore and must never be committed.
# The backend also accepts a `.env` in any parent folder, which is how the
# original author kept the key outside the homework directory.

# Portkey gateway key. Every agent calls OpenAI through Portkey.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional — only set this if you use a different Portkey endpoint.
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
